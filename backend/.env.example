MONGO_URI=mongodb://127.0.0.1:27017/clothing_shop
PORT=5000
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
NODE_ENV=development
CLIENT_URL=http://localhost:5173
AUTH_RATE_LIMIT=20
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="Clothing Shop <no-reply@example.com>"
ADMIN_NAME=Initial Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose_a_strong_password
EMPLOYEE_NAME=Initial Employee
EMPLOYEE_EMAIL=employee@example.com
EMPLOYEE_PASSWORD=choose_a_strong_password

# Order and inventory transactions require a replica set.
# Run npm run db:local to copy a local standalone DB and configure a local replica.
# MONGO_URI=mongodb://127.0.0.1:27028/clothing_shop?replicaSet=clothingLocal
